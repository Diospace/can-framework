import { signal } from '@decaspace/can-framework';
import { HelloWorld } from './components/HelloWorld.can';

component App {
    var navOpen = signal(false);
    var year = signal(new Date().getFullYear());

    var sampleCode = [
        "component HelloWorld {",
        "    var name = signal('World');",
        "    var template " + "= '<h1>Hello, {{name}}!</h1>';",
        "}"
    ].join("\n");

    function toggleNav() {
        this.navOpen.value = !this.navOpen.value;
    }

    function closeNav() {
        this.navOpen.value = false;
    }

    var template = `
        <div class="page">
            <nav class="nav">
                <div class="nav-inner">
                    <a class="brand" href="#top">
                        <img src="/can.png" alt="Can Framework logo" class="brand-logo" />
                        <span class="brand-name">Can<span class="brand-accent">JS</span></span>
                    </a>
                    <button class="hamburger {{ navOpen.value ? 'open' : '' }}" @click="toggleNav" aria-label="Toggle navigation">
                        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
                    </button>
                    <div class="nav-links {{ navOpen.value ? 'open' : '' }}">
                        <a href="#features" @click="closeNav">Features</a>
                        <a href="#demo" @click="closeNav">Live Demo</a>
                        <a href="#get-started" @click="closeNav">Get Started</a>
                        <a href="#why" @click="closeNav">Why Can?</a>
                        <a class="btn btn-small" href="#get-started" @click="closeNav">Start Building</a>
                    </div>
                </div>
            </nav>

            <header id="top" class="hero">
                <div class="hero-bg"></div>
                <div class="hero-inner">
                    <div class="hero-badge">
                        <span class="dot"></span> v1.1.8 · Signal-based reactivity
                    </div>
                    <h1 class="hero-title">Build the web,<br /><span class="gradient-text">the Can way.</span></h1>
                    <p class="hero-sub">
                        Can is a modern, high-performance web framework with <b>Signal-based reactivity</b>,
                        <b>Single File Components</b> (SFCs), a built-in router, store and animations —
                        all in a tiny, dependency-free core.
                    </p>
                    <div class="hero-actions">
                        <a class="btn btn-primary" href="#get-started">Get Started</a>
                        <a class="btn btn-ghost" href="#features">Explore Features</a>
                    </div>
                    <div class="hero-stats">
                        <div class="stat"><b>182</b><span>Source files</span></div>
                        <div class="stat"><b>1.1.8</b><span>Version</span></div>
                        <div class="stat"><b>Zero</b><span>Runtime deps</span></div>
                    </div>
                </div>
            </header>

            <section id="features" class="section">
                <div class="section-head">
                    <span class="eyebrow">What's inside</span>
                    <h2>Everything you need to build modern apps</h2>
                    <p>One framework, batteries included — no glue code required.</p>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">⚡</div>
                        <h3>Signal Reactivity</h3>
                        <p>Fine-grained updates with <code>signal()</code> — only the parts of the DOM that change are re-rendered.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🧩</div>
                        <h3>Single File Components</h3>
                        <p>Template, logic and scoped styles together in one <code>.can</code> file. Compile once, ship fast.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🧭</div>
                        <h3>Built-in Router</h3>
                        <p>Declarative routes, lazy loading and navigation guards without extra packages.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🗄️</div>
                        <h3>State Store</h3>
                        <p>A predictable store with actions, mutations, getters and built-in persistence.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🎬</div>
                        <h3>Animations</h3>
                        <p>Native animation helpers for transitions, lists and micro-interactions.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🛠️</div>
                        <h3>Dev Tools Ready</h3>
                        <p>Time-travel debugging, snapshots and a live DevTools bridge out of the box.</p>
                    </div>
                </div>
            </section>

            <HelloWorld msg="Can is reactive" />

            <section id="get-started" class="section get-started">
                <div class="section-head">
                    <span class="eyebrow">Get started</span>
                    <h2>Up and running in seconds</h2>
                </div>
                <div class="steps">
                    <div class="step">
                        <span class="step-num">1</span>
                        <div>
                            <h3>Create a project</h3>
                            <pre><code>npx can-framework create my-app</code></pre>
                        </div>
                    </div>
                    <div class="step">
                        <span class="step-num">2</span>
                        <div>
                            <h3>Run the dev server</h3>
                            <pre><code>cd my-app && npm run dev</code></pre>
                        </div>
                    </div>
                    <div class="step">
                        <span class="step-num">3</span>
                        <div>
                            <h3>Open your app</h3>
                            <pre><code>→ http://localhost:3000</code></pre>
                        </div>
                    </div>
                </div>
                <div class="code-block">
                    <div class="code-title"><span class="dot"></span> your-first-component.can</div>
                    <pre><code><span c-text="sampleCode"></span></code></pre>
                </div>
            </section>

            <section id="why" class="section why">
                <div class="section-head">
                    <span class="eyebrow">Why Can?</span>
                    <h2>Small. Fast. Yours.</h2>
                </div>
                <div class="why-grid">
                    <div class="why-item">
                        <h3>⚡ Tiny bundle</h3>
                        <p>A lean core that stays out of your way — more of your payload is your app.</p>
                    </div>
                    <div class="why-item">
                        <h3>🚀 Fast by default</h3>
                        <p>Compiled templates and signal tracking mean updates are precise and cheap.</p>
                    </div>
                    <div class="why-item">
                        <h3>🧘 Simple mental model</h3>
                        <p>Plain JavaScript + HTML in one file. No magic configs, no complex toolchains.</p>
                    </div>
                    <div class="why-item">
                        <h3>🔌 Zero runtime deps</h3>
                        <p>Framework first, dependencies later — install only what your app truly needs.</p>
                    </div>
                </div>
            </section>

            <footer class="footer">
                <div class="footer-inner">
                    <img src="/can.png" alt="Can Framework" class="footer-logo" />
                    <p class="footer-tag">Made with ❤️ by the Can framework team</p>
                    <p class="footer-copy">© {{year.value}} Can Framework · MIT License</p>
                </div>
            </footer>
        </div>
    `;
}

<style scoped>
