    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.4px;
}
.demo-card h3 { font-size: 1.6rem; margin: 1rem 0 0.4rem; color: #fff; }
.demo-card p { color: #a7b0c2; max-width: 520px; margin: 0 auto; }
.reactor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    margin: 2rem 0 1.2rem;
}
.r-btn {
    width: 64px; height: 64px;
    border-radius: 50%;
    border: 1px solid rgba(66,184,131,0.5);
    background: rgba(66,184,131,0.12);
    color: #42b883;
    font-size: 1.8rem;
    line-height: 1;
    padding: 0;
    font-weight: inherit;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease, box-shadow 0.2s ease;
}
.r-btn:hover { background: #42b883; color: #0b0f1a; transform: scale(1.08); }
.r-value {
    min-width: 90px;
    font-size: 3rem;
    font-weight: 800;
    color: #fff;
    text-shadow: 0 0 24px rgba(66,184,131,0.55);
}
.hint code {
    background: rgba(0,0,0,0.35);
