import { signal } from '@decaspace/can-framework';

component HelloWorld {
    var props = ['msg'];

    var count = signal(0);

    function inc() {
        this.count.value++;
    }

    function dec() {
        this.count.value--;
    }

    var template = `
        <section id="demo" class="demo-wrap">
            <div class="demo-card">
                <div class="demo-head">
                    <span class="pill">Live · Signal-powered</span>
                    <h3>{{msg}}</h3>
                    <p>This counter is a <b>Signal</b> updated in real time — no manual DOM work, no full-page re-render.</p>
                </div>
                <div class="reactor">
                    <button class="r-btn" @click="dec" aria-label="Decrease">−</button>
                    <span class="r-value">{{count.value}}</span>
                    <button class="r-btn" @click="inc" aria-label="Increase">+</button>
                </div>
                <div class="hint"><code>var count = signal(0)</code></div>
            </div>
        </section>
    `;
}

<style scoped>
