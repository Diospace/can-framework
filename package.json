{
  "name": "@decaspace/can-framework",
  "displayName": "Can Framework",
  "description": "A modern, high-performance web framework using Signal-based reactivity and Single File Components.",
  "publisher": "can-framework",
  "version": "1.1.5",
  "type": "module",
  "license": "MIT",
  "icon": "ide-extension/icons/can.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diospace/can-framework.git"
  },
  "homepage": "https://github.com/Diospace/can-framework#readme",
  "bugs": "https://github.com/Diospace/can-framework/issues",
  "bin": {
    "can": "./dist/bundler/index.mjs",
    "can-framework": "./dist/bundler/index.mjs",
    "can-debug": "./dist/cli/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "api",
    "templates",
    "build",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "can": "tsx src/cli/index.ts",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "type-check": "tsc --noEmit",
    "compile": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --outfile=dist/bundler/index.mjs --packages=external --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "compile:all": "npm run can -- build && tsc --emitDeclarationOnly",
    "api": "ts-node src/cli/build.ts api/index.ts api/routes.ts && node dist/api/index.mjs",
    "api:dev": "ts-node api/index.ts",
    "build:bundle": "webpack",
    "build:cdn": "webpack --config webpack.config.cdn2.cjs",
    "build:cdn:modern": "node scripts/cdn/build-cdn.js",
    "build:cdn:all": "npm run build:cdn && npm run build:cdn:modern",
    "test": "vitest --environment happy-dom",
    "vscode:build-extension": "esbuild ide-extension/extension.ts ide-extension/server.ts --bundle --outdir=ide-extension/out --external:vscode --external:esbuild --format=cjs --platform=node --minify --sourcemap --define:import.meta.url=import_meta_url_shim --banner:js=\"const import_meta_url_shim = require('url').pathToFileURL(__filename).href;\"",
    "vscode:prepublish": "npm run build && npm run vscode:build-extension",
    "release": "node scripts/release.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.82.0"
  },
  "dependencies": {
    "@types/htmlparser2": "^3.10.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "esbuild": "^0.27.3",
    "express": "^4.18.2",
    "htmlparser2": "^10.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.0.0",
    "postcss": "^8.4.31",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "typescript": "^5.7.2",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": false
    }
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "babel-loader": "^9.1.3",
    "happy-dom": "^12.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "vite": "^7.3.0",
    "vitest": "^1.2.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4"
  }
}