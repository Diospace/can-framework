{
	"Can Component": {
		"prefix": "component",
		"body": [
			"component ${1:MyComponent} {",
			"\tvar props = [",
			"\t\t'${2:title}'",
			"\t];",
			"",
			"\tvar ${3:count} = signal(0);",
			"",
			"\tfunction increment() {",
			"\t\tthis.${3:count}.value++;",
			"\t}",
			"",
			"\tvar template = `",
			"\t\t<div class=\"${1:MyComponent}\" @click=\"increment\">",
			"\t\t\t<h1>${1:MyComponent}</h1>",
			"\t\t\t<p>Count: {{ ${3:count}.value }}</p>",
			"\t\t\t<slot></slot>",
			"\t\t</div>",
			"\t`;",
			"}",
			"",
			"<style scoped>",
			".${1:MyComponent} {",
			"\t$0",
			"}",
			"</style>"
		],
		"description": "Create a new Can Component skeleton"
	},
	"Can Create Store": {
		"prefix": "createStore",
		"body": [
			"const ${1:store} = createStore({",
			"\tstate: () => ({",
			"\t\t${2:count}: 0",
			"\t}),",
			"\tmutations: {",
			"\t\t${3:increment}(state) {",
			"\t\t\tstate.${2:count}++;",
			"\t\t}",
			"\t},",
			"\tactions: {",
			"\t\tasync ${4:asyncIncrement}({ commit }) {",
			"\t\t\tawait new Promise(r => setTimeout(r, 1000));",
			"\t\t\tcommit('${3:increment}');",
			"\t\t}",
			"\t}",
			"});"
		],
		"description": "Scaffold a new Can Store"
	},
	"Can Use Store": {
		"prefix": "useStore",
		"body": [
			"const store = useStore();"
		],
		"description": "Access the global store instance"
	},
	"Can Create Router": {
		"prefix": "createRouter",
		"body": [
			"const router = createRouter({",
			"\troutes: [",
			"\t\t{ path: '/', component: ${1:Home} },",
			"\t\t{ path: '/${2:about}', component: ${3:About} }",
			"\t]",
			"});"
		],
		"description": "Scaffold a new Can Router"
	},
	"Can Use Router": {
		"prefix": "useRouter",
		"body": [
			"const router = useRouter();"
		],
		"description": "Access the router instance"
	},
	"Directive: c-if": {
		"prefix": "cif",
		"body": [
			"<div c-if=\"${1:condition}\">",
			"\t$0",
			"</div>"
		],
		"description": "Template if directive"
	},
	"Directive: c-for": {
		"prefix": "cfor",
		"body": [
			"<div c-for=\"${1:item} in ${2:items}\">",
			"\t{{ ${1:item} }}",
			"</div>"
		],
		"description": "Template for loop directive"
	},
	"Directive: c-model": {
		"prefix": "cmodel",
		"body": [
			"<input c-model=\"${1:state}\" />"
		],
		"description": "Two-way data binding"
	},
	"Directive: c-show": {
		"prefix": "cshow",
		"body": [
			"<div c-show=\"${1:condition}\">",
			"\t$0",
			"</div>"
		],
		"description": "Template show directive (toggles display)"
	},
	"Can Log Signal": {
		"prefix": "logSignal",
		"body": [
			"effect(() => console.log('${1:value}:', ${1:value}.value));"
		],
		"description": "Debug a signal using an effect"
	},
	"Composable: useToggle": {
		"prefix": "useToggle",
		"body": [
			"const [${1:value}, toggle${1/(.*)/${1:/capitalize}/}] = useToggle(${2:false});"
		],
		"description": "A boolean toggle hook"
	},
	"Composable: useEventListener": {
		"prefix": "useEventListener",
		"body": [
			"useEventListener(${1:window}, '${2:click}', (e) => {",
			"\t$0",
			"});"
		],
		"description": "Attach and automatically cleanup event listeners"
	},
	"Composable: useAnimate": {
		"prefix": "useAnimate",
		"body": [
			"const animation = useAnimate({",
			"\ttargets: '${1:.el}',",
			"\t${2:opacity}: [0, 1],",
			"\tduration: ${3:1000},",
			"\teasing: '${4:easeOutExpo}'",
			"});"
		],
		"description": "Orchestrate animations with automatic cleanup"
	}
}