{
	"name": "Can Dark",
	"type": "dark",
	"colors": {
		"editor.background": "#1E1E1E",
		"editor.foreground": "#D4D4D4",
		"editorLineNumber.foreground": "#858585",
		"editorLineNumber.activeForeground": "#C6C6C6",
		"editor.lineHighlightBackground": "#2F3337",
		"editor.selectionBackground": "#264F78",
		"editorIndentGuide.background": "#404040",
		"editorIndentGuide.activeBackground": "#707070"
	},
	"tokenColors": [
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": {
				"foreground": "#C586C0"
			}
		},
		{
			"scope": ["keyword.other.can", "source.can entity.name.function", "source.can support.function"],
			"settings": {
				"foreground": "#DCDCAA"
			}
		},
		{
			"scope": ["source.can entity.name.type", "source.can support.class"],
			"settings": {
				"foreground": "#4EC9B0",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["source.can variable", "source.can meta.definition.variable"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"scope": "variable.other.css",
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"scope": ["meta.interpolation.can", "meta.template.expression"],
			"settings": {
				"foreground": "#FF9E64"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"scope": "comment",
			"settings": {
				"foreground": "#6A9955"
			}
		},
		{
			"scope": ["entity.other.attribute-name", "entity.other.attribute-name.html"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"scope": "keyword.control.directive.can",
			"settings": {
				"foreground": "#FF9E64",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "entity.other.attribute-name.directive.can",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Can Framework Reactivity (signal, computed, effect)",
			"scope": ["support.function.reactive.can", "variable.language.signal.can"],
			"settings": {
				"foreground": "#4FC1FF",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Can Framework At-Prefix Variables",
			"scope": "variable.other.property.force-transform.can",
			"settings": {
				"foreground": "#C586C0"
			}
		},
		{
			"scope": "punctuation",
			"settings": {
				"foreground": "#D4D4D4"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
			"settings": {
				"foreground": "#B5CEA8"
			}
		}
	]
}