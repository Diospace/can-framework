{
  "name": "can-language-support",
  "displayName": "Can Framework Official Tooling",
  "description": "Language support and themes for the Can Framework",
  "version": "0.0.7",
  "publisher": "can-framework",
  "icon": "icons/can.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diospace/can-framework.git",
    "directory": "ide-extension"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onLanguage:can"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run build",
    "clean": "npx shx rm -rf out && npx shx rm -rf *.vsix",
    "build": "esbuild extension.ts server.ts --bundle --outdir=out --external:vscode --external:esbuild --format=cjs --platform=node --minify --sourcemap --define:import.meta.url=import_meta_url_shim --banner:js=\"const import_meta_url_shim = require('url').pathToFileURL(__filename).href;\"",
    "watch": "esbuild extension.ts server.ts --bundle --outdir=out --external:vscode --external:esbuild --format=cjs --platform=node --watch --sourcemap --define:import.meta.url=import_meta_url_shim --banner:js=\"const import_meta_url_shim = require('url').pathToFileURL(__filename).href;\"",
    "compile": "tsc -p ./ --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "prettier": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.70.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0",
    "shx": "^0.3.4"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "can",
        "aliases": [
          "Can",
          "can"
        ],
        "extensions": [
          ".can"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/can.png",
          "dark": "./icons/can.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "can",
        "scopeName": "source.can",
        "path": "./syntaxes/can.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "source.ts": "typescript",
          "source.js": "javascript",
          "source.css": "css",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "themes": [
      {
        "label": "Can Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/can-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "can-icon-theme",
        "label": "Can Icons",
        "path": "./themes/can-icon-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "can",
        "path": "./snippets/can.code-snippets"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "can": "html"
      }
    }
  }
}